<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ==================== Spring Boot 父级 ==================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.10</version>
        <relativePath/> <!-- 从 Maven 仓库中查找，不使用本地路径 -->
    </parent>

    <!-- ==================== 本项目坐标 ==================== -->
    <groupId>com.github.existed_name</groupId>
    <artifactId>tlias-management</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!-- pom 表示这是一个聚合/父模块，不产生 jar/war 产物 -->
    <packaging>pom</packaging>

    <!-- ==================== 子模块聚合 ==================== -->
    <!-- Maven 构建时会按顺序识别并构建以下子模块 -->
    <modules>
        <module>tlias-pojo</module>
        <module>tlias-util</module>
        <module>tlias-business</module>
    </modules>

    <!-- ==================== 统一版本号管理 ==================== -->
    <!--
        所有依赖、插件的版本号均在此处集中声明。
        子模块引用依赖时无需填写版本号，统一由此处控制，方便升级维护。
    -->
    <properties>
        <!-- Java 编译版本 -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <java.version>21</java.version>

        <!-- 源码编码 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ── 本项目内部子模块版本 ── -->
        <tlias.version>${project.version}</tlias.version>

        <!-- ── Spring Boot ── -->
        <!-- 注意：spring-boot-starter-parent 已锁定大部分 Spring 依赖版本，
             此处仅对父 POM 版本号与 starter 版本号进行显式声明，便于快速定位 -->
        <spring-boot-starter.version>3.5.11</spring-boot-starter.version>

        <!-- ── 工具类库 ── -->
        <lombok.version>1.18.44</lombok.version>

        <!-- ── MyBatis ── -->
        <mybatis-spring-boot.version>3.0.5</mybatis-spring-boot.version>

        <!-- ── 分页插件 ── -->
        <pagehelper-spring-boot.version>1.4.7</pagehelper-spring-boot.version>

        <!-- ── JWT ── -->
        <jjwt.version>0.9.1</jjwt.version>

        <!-- ── 阿里云 OSS ── -->
        <aliyun.oss.version>3.18.5</aliyun.oss.version>

        <!-- ── JAXB（Java 11+ 需手动引入，aliyun-sdk-oss 的传递依赖）── -->
        <jaxb-api.version>2.3.1</jaxb-api.version>
        <javax.activation.version>1.1.1</javax.activation.version>
        <jaxb-runtime.version>2.3.3</jaxb-runtime.version>
    </properties>

    <!-- ==================== 全局公共依赖 ==================== -->
    <!--
        此处声明的依赖会被【所有子模块】自动继承，无需在子模块中重复声明。
        仅放置真正所有模块都需要的依赖（如 lombok、spring-boot-starter）。
    -->
    <dependencies>
        <!--
            spring-boot-starter：提供 Spring 核心容器、自动配置、日志等基础能力。
            所有子模块均依赖 Spring 生态，故放置于此处全局继承。
            Source: https://mvnrepository.com/artifact/org.springframework.boot/spring-boot-starter
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <version>${spring-boot-starter.version}</version>
        </dependency>

        <!--
            Lombok：编译期注解处理器，自动生成 getter/setter/构造器等样板代码。
            所有模块的 POJO、Service 等均会用到，故全局引入。
            scope=provided 表示仅编译期使用，不会打入最终产物。
            Source: https://mvnrepository.com/artifact/org.projectlombok/lombok
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <!-- ==================== 依赖版本锁定（不自动引入）==================== -->
    <!--
        dependencyManagement 中声明的依赖【不会自动被子模块继承】，
        只是锁定版本。子模块需要时，只写 groupId + artifactId 即可，
        版本由此处统一提供，避免各模块版本不一致。
    -->
    <dependencyManagement>
        <dependencies>

            <!-- ── 本项目子模块 ── -->
            <!--
                将子模块版本也纳入管理，方便 tlias-business 引用时不写死版本号。
            -->
            <dependency>
                <groupId>com.github.existed_name</groupId>
                <artifactId>tlias-pojo</artifactId>
                <version>${tlias.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.existed_name</groupId>
                <artifactId>tlias-util</artifactId>
                <version>${tlias.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.existed_name</groupId>
                <artifactId>tlias-business</artifactId>
                <version>${tlias.version}</version>
            </dependency>

            <!-- ── MyBatis Spring Boot Starter ── -->
            <!-- Source: https://mvnrepository.com/artifact/org.mybatis.spring.boot/mybatis-spring-boot-starter -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>
            <!-- MyBatis 测试支持 -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter-test</artifactId>
                <version>${mybatis-spring-boot.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- ── 分页插件 PageHelper ── -->
            <!-- Source: https://mvnrepository.com/artifact/com.github.pagehelper/pagehelper-spring-boot-starter -->
            <dependency>
                <groupId>com.github.pagehelper</groupId>
                <artifactId>pagehelper-spring-boot-starter</artifactId>
                <version>${pagehelper-spring-boot.version}</version>
            </dependency>

            <!-- ── JWT 令牌 ── -->
            <!-- Source: https://mvnrepository.com/artifact/io.jsonwebtoken/jjwt -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- ── 阿里云 OSS SDK ── -->
            <!-- Source: https://mvnrepository.com/artifact/com.aliyun.oss/aliyun-sdk-oss -->
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun.oss.version}</version>
            </dependency>

            <!-- ── JAXB：aliyun-sdk-oss 在 Java 11+ 环境下需要手动补充以下三个依赖 ── -->
            <!-- JAXB API -->
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>${jaxb-api.version}</version>
            </dependency>
            <!-- JavaBeans Activation Framework（JAF），JAXB 运行时依赖 -->
            <dependency>
                <groupId>javax.activation</groupId>
                <artifactId>activation</artifactId>
                <version>${javax.activation.version}</version>
            </dependency>
            <!-- JAXB 运行时实现，注意：版本不能高于 2.3.3，否则与 aliyun-sdk-oss 不兼容 -->
            <dependency>
                <groupId>org.glassfish.jaxb</groupId>
                <artifactId>jaxb-runtime</artifactId>
                <version>${jaxb-runtime.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>