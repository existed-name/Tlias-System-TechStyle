<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- ==================== 继承父模块 ==================== -->
	<!--
        继承 tlias-management 父 POM，版本号均由父 POM 的 dependencyManagement 提供，
        此处引用依赖时无需填写 <version>。
    -->
	<parent>
		<groupId>com.github.existed_name</groupId>
		<artifactId>tlias-management</artifactId>
		<version>1.0-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<!-- ==================== 本模块坐标 ==================== -->
	<!--
        groupId 从父模块继承，无需重复声明。
        tlias-business：核心业务模块，包含 Controller / Service / Mapper 及启动类，
        是唯一可运行的 Spring Boot 应用模块。
    -->
	<artifactId>tlias-business</artifactId>
	<name>tlias-business</name>
	<description>tlias-business</description>

	<!-- ==================== 本模块专属依赖 ==================== -->
	<dependencies>

		<!-- ── 项目内部子模块 ── -->
		<!--
            tlias-pojo：提供全局 Entity / DTO / VO 数据对象。
            tlias-util：提供 JWT、OSS 等公共工具类。
            版本由父 POM dependencyManagement 统一管理。
        -->
		<dependency>
			<groupId>com.github.existed_name</groupId>
			<artifactId>tlias-pojo</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.existed_name</groupId>
			<artifactId>tlias-util</artifactId>
		</dependency>

		<!-- ── Spring Boot Web ── -->
		<!--
            提供 Spring MVC、内嵌 Tomcat、RESTful API 支持。
            版本由 spring-boot-starter-parent 统一管理，无需填写。
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- ── Spring Boot AOP ── -->
		<!--
            提供面向切面编程支持，用于日志记录、操作审计等切面逻辑。
            版本由 spring-boot-starter-parent 统一管理，无需填写。
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-aop</artifactId>
		</dependency>

		<!-- Spring Boot validation -->
		<!--
			@NotNull等等注解
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>


		<!-- ── MyBatis Spring Boot Starter ── -->
		<!--
            整合 MyBatis 与 Spring Boot，提供 Mapper 扫描、SqlSession 自动配置等。
            版本由父 POM dependencyManagement 统一管理（3.0.5）。
            Source: https://mvnrepository.com/artifact/org.mybatis.spring.boot/mybatis-spring-boot-starter
        -->
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter</artifactId>
		</dependency>

		<!-- ── MySQL 驱动 ── -->
		<!--
            运行时加载的 MySQL JDBC 驱动。
            scope=runtime 表示编译期不需要，仅运行时使用。
            版本由 spring-boot-starter-parent 统一管理，无需填写。
        -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ── 分页插件 PageHelper ── -->
		<!--
            基于 MyBatis 拦截器实现物理分页，无需手写 LIMIT 语句。
            版本由父 POM dependencyManagement 统一管理（1.4.7）。
            Source: https://mvnrepository.com/artifact/com.github.pagehelper/pagehelper-spring-boot-starter
        -->
		<dependency>
			<groupId>com.github.pagehelper</groupId>
			<artifactId>pagehelper-spring-boot-starter</artifactId>
		</dependency>

		<!-- ── 测试依赖 ── -->
		<!--
            spring-boot-starter-test：提供 JUnit 5、Mockito、AssertJ 等测试框架。
            mybatis-spring-boot-starter-test：提供 @MybatisTest 切片测试支持。
            scope=test 表示仅在测试阶段使用，不会打入生产包。
        -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<!-- ==================== 构建插件 ==================== -->
	<build>

<!--		<finalName>tlias-management-backend</finalName>-->
		<finalName>app</finalName>

		<plugins>

			<!--
                maven-compiler-plugin：配置 Lombok 注解处理器路径。
                Lombok 在编译期生成代码，需要通过 annotationProcessorPaths 显式声明，
                否则在某些 IDE 或 CI 环境下可能无法正确处理注解。
                版本由 spring-boot-starter-parent 管理，无需填写。
            -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>

			<!--
                spring-boot-maven-plugin：将项目打包为可执行的 fat jar（包含所有依赖）。
                excludes 中排除 lombok，因为 lombok 仅在编译期使用，
                不需要打入最终运行的 jar 包，避免产物体积冗余。
                版本由 spring-boot-starter-parent 管理，无需填写。
            -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>

		</plugins>

	</build>

</project>